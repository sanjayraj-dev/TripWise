# Copy to backend/.env or the repo root .env (pydantic-settings reads backend working directory).

SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://tripwise:tripwise@localhost:5432/tripwise
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_EXPIRE_MINUTES=480
INACTIVITY_TIMEOUT_MINUTES=30

# SpaceXAI / xAI — used for SF-011 itinerary drafts. Leave empty to use the city template fallback.
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1
